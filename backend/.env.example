PORT=5000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ideahub
JWT_SECRET=change-this-to-a-long-random-secret
CLIENT_URL=http://localhost:5000
PUBLIC_BASE_URL=http://localhost:5000
MAX_VIDEO_MB=100
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000
# Set DB_SSL=true for hosted PostgreSQL providers that require TLS.
DB_SSL=false
